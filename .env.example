# Copy to .env and fill in. .env is git-ignored.

# Your Proton address (the username shown in Proton Mail Bridge)
PROTON_BRIDGE_USER=you@proton.me

# The Bridge password shown in Proton Mail Bridge (NOT your Proton account password)
PROTON_BRIDGE_PASSWORD=

# Bridge defaults
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_BRIDGE_SMTP_PORT=1025

# Optional: path to the TLS certificate exported from Bridge
# (Bridge > Settings > Advanced > Export TLS certificates).
# If empty, certificate verification is skipped — only allowed for 127.0.0.1/localhost.
PROTON_BRIDGE_CERT=

# Sending is disabled unless this is 1. Even when enabled, sending only works
# for an existing draft, and Claude should be configured to ask you every time.
PROTON_ALLOW_SEND=0
