{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["WebFetch(domain:pkg.go.dev)", "WebFetch(domain:go.dev)", "WebFetch(domain:github.com)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(**/*.pem)", "Read(**/*.crt)", "Edit(./.env)", "Write(./.env)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/gofmt-edited.ps1\"", "timeout": 30 }
        ]
      }
    ]
  }
}
